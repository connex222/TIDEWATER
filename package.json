{
  "name": "tidewater",
  "version": "0.11.0",
  "private": true,
  "description": "Tidewater Phase 11 \u2014 host disconnect safety, live WebSocket acceptance and release checks",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "balance": "node tools/balance_tournament.js 100",
    "test:game-night": "node --test test/phase10.test.js",
    "test:live": "node tools/phase11-live-acceptance.js",
    "test:release": "npm test && npm run test:live"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "8.18.3"
  }
}
